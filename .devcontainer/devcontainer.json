{
  "name": "Pipeline de preços",
  "dockerComposeFile": ["../compose.yaml", "compose.yaml"],
  "service": "dev",
  "runServices": ["dev", "api", "scheduler", "dag-processor"],
  "workspaceFolder": "/workspace",
  "remoteUser": "airflow",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "dockerDashComposeVersion": "v2"
    }
  },
  "remoteEnv": {
    "PRICING_BIND_ROOT": "${localWorkspaceFolder}"
  },
  "postCreateCommand": "uv sync --locked",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "ruff.path": ["/opt/venv/bin/ruff"],
        "yaml.customTags": ["!override sequence"]
      }
    }
  }
}
